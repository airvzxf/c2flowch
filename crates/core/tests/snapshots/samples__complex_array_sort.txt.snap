(  Start: bubble_sort(arr, n)  )
                │
                🭭
          ┌───────────┐
          │   i ← 0   │
          └─────┬─────┘
                │
                ├🭮──────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐
                │                                                                                                                   │
                🭭                                                                                                                   │
               🯐🯓                                                                                                                   │
            🯐      🯓                                                                                                                │
         🯐            🯓   True                                                                                                      │
       🯝   i < n - 1    🯟───────────────┐                                                                                           │
         🯒            🯑                 │                                                                                           │
            🯒      🯑                    🭭                                                                                           │
               🯒🯑                 ┌───────────┐                                                                                     │
         False  │                 │   j ← 0   │                                                                                     │
                │                 └─────┬─────┘                                                                                     │
                │                       │                                                                                           │
                │                       ├🭮───────────────────────────────────────────────────────────────────────────────────────┐  │
                │                       │                                                                                        │  │
                │                       🭭                                                                                        │  │
                │                      🯐🯓                                                                                        │  │
                │                  🯐        🯓                                                                                    │  │
                │              🯐                🯓    True                                                                        │  │
                │           🯝    j < n - i - 1     🯟──────────────────┐                                                          │  │
                │              🯒                🯑                     │                                                          │  │
                │                  🯒        🯑                         🭭                                                          │  │
                │                      🯒🯑                            🯐🯓                                                          │  │
                │                False  │                       🯐          🯓                                                     │  │
                │                       │                  🯐                    🯓     True                                       │  │
                │                       │              🯝    arr[j] > arr[j + 1]     🯟───────────────────────┐                    │  │
                │                       │                  🯒                    🯑                           │                    │  │
                │                       │                       🯒          🯑                                🭭                    │  │
                │                       │                            🯒🯑                   ┌─┬───────────────────────────────┬─┐  │  │
                │                       │                      False  │                   │ │   swap(arr[j], arr[j + 1])    │ │  │  │
                │                       │                             │                   └─┴───────────────┬───────────────┴─┘  │  │
                │                       │                             │                                     │                    │  │
                │                       │                             ├🭮────────────────────────────────────┘                    │  │
                │                       │                             │                                                          │  │
                │                       │                             🭭                                                          │  │
                │                       │                     ┌───────────────┐                                                  │  │
                │                       │                     │   j ← j + 1   │                                                  │  │
                │                       │                     └───────┬───────┘                                                  │  │
                │                       │                             │                                                          │  │
                │                       │                             └──────────────────────────────────────────────────────────┘  │
                │                       │                                                                                           │
                │                       │                                                                                           │
                │                       🭭                                                                                           │
                │               ┌───────────────┐                                                                                   │
                │               │   i ← i + 1   │                                                                                   │
                │               └───────┬───────┘                                                                                   │
                │                       │                                                                                           │
                │                       └───────────────────────────────────────────────────────────────────────────────────────────┘
                │
                │
                🭭
          (  Return  )


