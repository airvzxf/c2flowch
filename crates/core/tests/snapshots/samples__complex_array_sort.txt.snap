---
source: crates/core/tests/samples.rs
expression: render_ascii(&p)
---
                 (  Start  )
                      |
                      v
+-------------------------------------------+
|   data <- {64, 34, 25, 12, 22, 11, 90}    |
|   n <- 7                                  |
+---------------------+---------------------+
                      |
                      v
       *-------------------------------*
      /   Print "Unsorted array: "    /
     *----------------+--------------*
                      |
                      v
      +-+---------------------------+-+
      | |   print_array(data, n)    | |
      +-+-------------+-------------+-+
                      |
                      v
      +-+---------------------------+-+
      | |   bubble_sort(data, n)    | |
      +-+-------------+-------------+-+
                      |
                      v
        *-----------------------------*
       /   Print "Sorted array: "    /
      *---------------+-------------*
                      |
                      v
      +-+---------------------------+-+
      | |   print_array(data, n)    | |
      +-+-------------+-------------+-+
                      |
                      v
                  (  End  )


(  Start: print_array(arr, size)  )
                 |
                 v
          +-------------+
          |   i <- 0    |
          +------+------+
                 |
                 +<---------------------------------------+
                 |                                        |
                 v                                        |
                /\                                        |
             /      \                                     |
          /            \   True                           |
        <    i < size    >----------------+               |
          \            /                  |               |
             \      /                     v               |
                \/             *-----------------------*  |
          False  |            /   Print arr[i], " "   /   |
                 |           *------------+----------*    |
                 |                        |               |
                 |                        v               |
                 |               +-----------------+      |
                 |               |   i <- i + 1    |      |
                 |               +--------+--------+      |
                 |                        |               |
                 |                        +---------------+
                 |
                 |
                 v
          *---------------*
         /   Print ""    /
        *--------+------*
                 |
                 v
           (  Return  )


(  Start: bubble_sort(arr, n)  )
                |
                v
         +-------------+
         |   i <- 0    |
         +------+------+
                |
                +<------------------------------------------------------------------------------------------------------------------+
                |                                                                                                                   |
                v                                                                                                                   |
               /\                                                                                                                   |
            /      \                                                                                                                |
         /            \   True                                                                                                      |
       <   i < n - 1    >---------------+                                                                                           |
         \            /                 |                                                                                           |
            \      /                    v                                                                                           |
               \/                +-------------+                                                                                    |
         False  |                |   j <- 0    |                                                                                    |
                |                +------+------+                                                                                    |
                |                       |                                                                                           |
                |                       +<---------------------------------------------------------------------------------------+  |
                |                       |                                                                                        |  |
                |                       v                                                                                        |  |
                |                      /\                                                                                        |  |
                |                  /        \                                                                                    |  |
                |              /                \    True                                                                        |  |
                |           <    j < n - i - 1     >------------------+                                                          |  |
                |              \                /                     |                                                          |  |
                |                  \        /                         v                                                          |  |
                |                      \/                            /\                                                          |  |
                |                False  |                       /          \                                                     |  |
                |                       |                  /                    \     True                                       |  |
                |                       |              <    arr[j] > arr[j + 1]     >-----------------------+                    |  |
                |                       |                  \                    /                           |                    |  |
                |                       |                       \          /                                v                    |  |
                |                       |                            \/                   +-+-------------------------------+-+  |  |
                |                       |                      False  |                   | |   swap(arr[j], arr[j + 1])    | |  |  |
                |                       |                             |                   +-+---------------+---------------+-+  |  |
                |                       |                             |                                     |                    |  |
                |                       |                             +<------------------------------------+                    |  |
                |                       |                             |                                                          |  |
                |                       |                             v                                                          |  |
                |                       |                    +-----------------+                                                 |  |
                |                       |                    |   j <- j + 1    |                                                 |  |
                |                       |                    +--------+--------+                                                 |  |
                |                       |                             |                                                          |  |
                |                       |                             +----------------------------------------------------------+  |
                |                       |                                                                                           |
                |                       |                                                                                           |
                |                       v                                                                                           |
                |              +-----------------+                                                                                  |
                |              |   i <- i + 1    |                                                                                  |
                |              +--------+--------+                                                                                  |
                |                       |                                                                                           |
                |                       +-------------------------------------------------------------------------------------------+
                |
                |
                v
          (  Return  )


(  Start: swap(a, b)  )
           |
           v
   +---------------+
   |   temp <- a   |
   |   a <- b      |
   |   b <- temp   |
   +-------+-------+
           |
           v
     (  Return  )
