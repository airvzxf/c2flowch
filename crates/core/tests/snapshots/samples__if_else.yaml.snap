title: if_else.c
lang: en
functions:
- name: main
  entry: true
  body:
  - io: Print "Inicio"
  - process: i <- 0
  - if:
      cond: i = 0
      then:
      - io: 'Print "i: ", i'
      else:
      - io: 'Print "i else: ", i'
  - io: Print "Fin"
  - return: '0'
