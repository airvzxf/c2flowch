---
source: crates/core/tests/samples.rs
expression: p.to_yaml().unwrap()
---
title: while_nested.c
lang: en
functions:
- name: main
  entry: true
  body:
  - io: Print "Inicio"
  - process: i ← 0
  - while:
      cond: i < 5
      body:
      - io: Print "Iterar i"
      - process: j ← 0
      - while:
          cond: j < 5
          body:
          - io: |-
              Print "Iterar j"
              Print "While: ", i, ", ", j
          - process: j ← j + 1
      - process: i ← i + 1
  - io: Print "Fin"
  - return: '0'
