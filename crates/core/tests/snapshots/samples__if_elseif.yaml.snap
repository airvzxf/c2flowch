---
title: if_elseif.c
lang: en
functions:
- name: main
  entry: true
  body:
  - io: Print "Inicio"
  - process: i ← 0
  - if:
      cond: i = 0
      then:
      - io: 'Print "i: ", i'
      else:
      - if:
          cond: i = 1
          then:
          - io: 'Print "i == 1: ", i'
  - io: Print "Fin"
  - return: '0'
