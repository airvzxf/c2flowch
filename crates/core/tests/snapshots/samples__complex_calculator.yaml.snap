---
source: crates/core/tests/samples.rs
expression: p.to_yaml().unwrap()
---
title: complex_calculator.c
lang: en
functions:
- name: main
  entry: true
  body:
  - process: choice <- 0
  - do_while:
      body:
      - call: print_menu()
      - io: |-
          Print "Enter choice: "
          Read choice
      - if:
          cond: choice = 1 or choice = 2
          then:
          - io: |-
              Print "Enter two numbers: "
              Read x, y
      - switch:
          expr: choice
          cases:
          - values:
            - '1'
            body:
            - call: res <- add(x, y)
            - io: 'Print "Result: ", res'
            - break
          - values:
            - '2'
            body:
            - call: res <- subtract(x, y)
            - io: 'Print "Result: ", res'
            - break
          - values:
            - '3'
            body:
            - io: Print "Exiting..."
            - break
          - default: true
            body:
            - io: Print "Invalid choice!"
      cond: choice != 3
  - return: '0'
- name: print_menu
  body:
  - io: |-
      Print "1. Add"
      Print "2. Subtract"
      Print "3. Exit"
- name: add
  params:
  - a
  - b
  body:
  - return: a + b
- name: subtract
  params:
  - a
  - b
  body:
  - return: a - b
